thptluongthucky.edu.vn	 {
    # Proxy toàn bộ request đến nginx của frontend
    reverse_proxy frontend:80

    # Logging
    log {
        output file /data/logs/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }

    # Header bảo mật
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
    }

    # Encode response
    encode gzip zstd
}

# Redirect www → non-www (bỏ nếu không cần)
www.thptluongthucky.edu.vn {
    redir https://thptluongthucky.edu.vn{uri} permanent
}
